{
  "compilerOptions": {
    "module": "nodenext",
    "isolatedModules": true,
    "target": "es2023",
    "outDir": "dist",
    "rootDir": ".",
    "removeComments": true,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src/server", "test", "vitest.config.ts"]
}
